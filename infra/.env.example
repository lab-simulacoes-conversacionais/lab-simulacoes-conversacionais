# Copiado para /opt/poc23/<ambiente>/.env pelo provision.sh, com permissão 600.
# Preencha na VM. Valores reais nunca entram no repositório.
# Gere as senhas com: openssl rand -hex 24

# homologacao ou piloto. O provision.sh preenche.
AMBIENTE=

# Atualizada pelo scripts/deploy.sh. Deixe vazia até o primeiro deploy.
IMAGE_TAG=

DB_NAME=lab_simulacoes
DB_USER=lab
DB_PASSWORD=
REDIS_PASSWORD=
OPENAI_API_KEY=

# Modelo da OpenAI (RNF-02). Vazio usa o padrão da aplicação, escolhido na issue #14.
IA_MODELO_CHAT=

# Obrigatória: sem ela a sugestão de cenário não roda (o chat continua funcionando).
IA_MODELO_SUGESTAO=gpt-6.1-terra
# Preços do modelo em dólares por 1 milhão de tokens (RNF-13), um para cada uso. Troque junto com o
# modelo ou o nível de serviço do uso.
# Fala do personagem (IA_MODELO_CHAT, nível prioritário). Vazios: tarifa do gpt-6.1-terra nesse nível,
# 2.00 e 10.00.
IA_PRECO_ENTRADA=
IA_PRECO_SAIDA=
# Sugestão de cenário (IA_MODELO_SUGESTAO, nível padrão). Vazios: tarifa do gpt-6.1-terra nesse nível,
# 1.00 e 5.00.
IA_PRECO_SUGESTAO_ENTRADA=
IA_PRECO_SUGESTAO_SAIDA=

# Tempo sem atividade até a sessão expirar (RNF-09).
SESSAO_INATIVIDADE=60m

# Backups mais antigos que isto são apagados. Ver docs/operacao/hospedagem.md antes de aumentar.
BACKUP_RETENCAO_DIAS=14

# Limite de memória da aplicação. Em uma VM com os dois ambientes, some os dois ao dimensionar.
APP_MEM_LIMIT=1g

# Segundos que o deploy espera a aplicação ficar saudável antes de voltar à tag anterior.
DEPLOY_TIMEOUT=180
