# Copiado para /opt/poc23/<ambiente>/.env pelo provision.sh, com permissão 600.
# Preencha na VM. Valores reais nunca entram no repositório.
# Gere as senhas com: openssl rand -hex 24

# homologacao ou piloto. O provision.sh preenche.
AMBIENTE=

# Atualizada pelo scripts/deploy.sh. Deixe vazia até o primeiro deploy.
IMAGE_TAG=

DB_NAME=lab_simulacoes
DB_USER=lab
DB_PASSWORD=
REDIS_PASSWORD=
OPENAI_API_KEY=

# Tempo sem atividade até a sessão expirar (RNF-09).
SESSAO_INATIVIDADE=60m

# Backups mais antigos que isto são apagados. Ver docs/operacao/hospedagem.md antes de aumentar.
BACKUP_RETENCAO_DIAS=14

# Limite de memória da aplicação. Em uma VM com os dois ambientes, some os dois ao dimensionar.
APP_MEM_LIMIT=1g

# Segundos que o deploy espera a aplicação ficar saudável antes de voltar à tag anterior.
DEPLOY_TIMEOUT=180
